! Flat dark style matching the app shell, so the embedded desktop does not
! look like a stray X session inside the product.
background:                          flat
background.color:                    #0D0D0E

*.font:                              sans-8
*.textColor:                         #ECECEE
*.justify:                           left

window.title.focus:                  flat solid
window.title.focus.color:            #17171A
window.title.unfocus:                flat solid
window.title.unfocus.color:          #101012
window.label.focus:                  flat solid
window.label.focus.color:            #17171A
window.label.focus.textColor:        #ECECEE
window.label.unfocus:                flat solid
window.label.unfocus.color:          #101012
window.label.unfocus.textColor:      #6C6C70
window.handle.focus:                 flat solid
window.handle.focus.color:           #17171A
window.handle.unfocus:               flat solid
window.handle.unfocus.color:         #101012
window.grip.focus:                   flat solid
window.grip.focus.color:             #26262A
window.grip.unfocus:                 flat solid
window.grip.unfocus.color:           #17171A
window.button.focus:                 flat solid
window.button.focus.color:           #17171A
window.button.focus.picColor:        #ECECEE
window.button.unfocus:               flat solid
window.button.unfocus.color:         #101012
window.button.unfocus.picColor:      #6C6C70
window.bevelWidth:                   0
window.borderWidth:                  1
window.borderColor:                  #26262A
window.title.height:                 26
window.justify:                      center

menu.title:                          flat solid
menu.title.color:                    #17171A
menu.title.textColor:                #ECECEE
menu.frame:                          flat solid
menu.frame.color:                    #141416
menu.frame.textColor:                #ECECEE
menu.hilite:                         flat solid
menu.hilite.color:                   #26262A
menu.hilite.textColor:               #FFFFFF
menu.bevelWidth:                     2
menu.borderWidth:                    1
menu.borderColor:                    #26262A
menu.itemHeight:                     22

toolbar:                             flat solid
toolbar.color:                       #0D0D0E
toolbar.borderWidth:                 0
toolbar.height:                      0
